{
  "name": "linkedin-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "login": "tsx src/cli/login.ts",
    "collect": "tsx src/cli/collect.ts",
    "analytics": "tsx src/cli/analytics.ts",
    "status": "tsx src/cli/status.ts",
    "start": "tsx src/cli/start.ts",
    "migrate": "node scripts/migrate-db.mjs",
    "sync": "bash scripts/sync.sh",
    "dashboard": "tsx src/cli/dashboard.ts",
    "feed": "tsx src/cli/feed.ts",
    "reset": "node scripts/reset-data.mjs"
  },
  "dependencies": {
    "playwright": "^1.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  },
  "license": "MIT",
  "description": "Collects your own LinkedIn posts, their reach and your follower count as a time series, and shows them in a local dashboard.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mario-Mohar/linkedin-panel.git"
  }
}
